# Copy to .env.local and fill in from your Supabase project
# (Project Settings -> API). Both values are public: the anon key ships in the
# browser bundle and Row Level Security is what protects the data.
#
# Never put SUPABASE_SERVICE_ROLE_KEY in this file. It bypasses RLS, and
# anything prefixed NEXT_PUBLIC_ is embedded in the client bundle.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Administrators are NOT configured here. Who may hold the admin role lives in
# public.admin_allowlist, a table no browser session can read or write, because
# an environment variable checked in the app was skippable: the promotion RPC is
# reachable with the public anon key, so any signed-in user could call it and be
# promoted. Add an address in the Supabase SQL editor instead:
#
#   insert into public.admin_allowlist (email) values ('you@example.com');
#
# then sign in again, or have an existing admin promote you from /admin.

# Before this works:
#   1. apply ../supabase/schema.sql in the Supabase SQL editor
#   2. enable the Google provider under Authentication -> Providers
#      and add <your-site>/auth/callback as an authorised redirect URL
