# Copy to .env.local. NEXT_PUBLIC_SUPABASE_* are Auth only (Google sign-in,
# JWT, session cookies). Application data lives in Cloudflare D1.
#
# Never prefix a service-role or provider key with NEXT_PUBLIC_: that would
# embed it in the browser bundle. The server-only values below belong in the
# deployment environment and must never be committed with real values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://www.hyn-view.in

# Heroku uses one ordinary Node process. Enable only with a separately
# configured compatible durable Workflow runtime.
HYN_ENABLE_WORKFLOW_WATCHDOG=false

# Shared server-side delivery. One Resend key serves every portal account;
# clients configure only recipients, message types, time, and timezone.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_your_key
EMAIL_FROM="HYN-view <reports@hyn-view.info>"
CRON_SECRET=generate-a-long-random-value

# Cloudflare D1 data plane. When set, heartbeats/readings/pairing/dashboard
# data go to the Worker; Supabase is used only for Auth JWTs.
HYN_DATA_API_URL=http://127.0.0.1:8787
HYN_DATA_SERVICE_KEY=generate-a-long-random-value

# Administrators are NOT configured here. With D1, BOOTSTRAP_EMAIL on the
# Worker becomes Super admin on first sign-in. Further operators: promote from
# /admin, or insert into D1 admin_allowlist. Without HYN_DATA_API_URL, the
# same rule uses public.admin_allowlist in Postgres (no browser policies).

# Before this works:
#   1. deploy cloudflare/ (see cloudflare/README.md) and set HYN_DATA_API_URL
#   2. enable the Google provider under Authentication -> Providers
#      and allow both https://www.hyn-view.in/auth/callback and
#      https://hyn-view.in/auth/callback. Keep the Site URL on https://www.hyn-view.in.

# Optional: another HTTPS gateway on the SAME Mosaic devnet used by Highway.
# The relayer integration has a working public default and requires no account
# password or signing key. See docs/relayer-dashboard.md.
# HIGHWAY_MOSAIC_RPC_URL=https://devnet-gw1.mosaicchain.io/MosaicNode2/chain
