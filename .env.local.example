# Copy to .env.local and fill in from your Supabase project
# (Project Settings -> API). Both values are public: the anon key ships in the
# browser bundle and Row Level Security is what protects the data.
#
# Never put SUPABASE_SERVICE_ROLE_KEY in this file. It bypasses RLS, and
# anything prefixed NEXT_PUBLIC_ is embedded in the client bundle.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated email addresses that are auto-promoted to administrator on
# their next sign-in. Checked server-side against the session's own verified
# email -- a user can never grant themselves admin by claiming someone else's
# address. Optional: leave unset if you only manage admins by hand in the
# Supabase dashboard.
ADMIN_EMAILS=

# Before this works:
#   1. apply ../supabase/schema.sql in the Supabase SQL editor
#   2. enable the Google provider under Authentication -> Providers
#      and add <your-site>/auth/callback as an authorised redirect URL
