# mono -- greyscale, with colour reserved entirely for warnings. If a serial
# console or a 16-colour terminal is mangling the other themes, use this: the
# layout carries the information and colour only ever means "look here".
fg       = #d0d0d0
dim      = #6c6c6c
border   = #3a3a3a
title    = #ffffff
accent   = #bcbcbc
accent2  = #9e9e9e
ok       = #a8a8a8
warn     = #ffaf00
crit     = #ff5f5f
rx       = #d0d0d0
tx       = #949494
g_low    = #767676
g_mid    = #bcbcbc
g_high   = #ff5f5f
