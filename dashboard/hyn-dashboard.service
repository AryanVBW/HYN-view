[Unit]
Description=VPS dashboard (live metrics, services, deployments, alerts)
After=network.target
# Never let a bad few seconds permanently abandon the dashboard.
StartLimitIntervalSec=0

[Service]
Type=simple
# @NODE@ is replaced by install.sh with the node that is actually installed.
ExecStart=@NODE@ /opt/hyn-dashboard/server.mjs
# Optional overrides: DASH_PORT, DASH_HOST, DASH_TOKEN, DASH_WEBHOOK_URL, HYN_REPO
EnvironmentFile=-/etc/hyn-dashboard.env
Environment=NODE_ENV=production
Restart=always
RestartSec=3
TimeoutStopSec=10

# Lowest priority: this box runs a relayer, the dashboard must never compete with it.
Nice=10
CPUWeight=20
IOWeight=20
MemoryHigh=120M
MemoryMax=160M
OOMScoreAdjust=300
TasksMax=64

# Read-only observer. Writes only to /var/lib/hyn-dashboard.
User=root
# Only the ability to read root-owned files. No network admin, no ptrace: the HTTP-facing process
# must not be able to reconfigure the host even if it were compromised.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
StateDirectory=hyn-dashboard
StateDirectoryMode=0700
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
