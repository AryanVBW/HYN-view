[Unit]
Description=VPS configuration and state backup
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hyn-sysbackup.sh
EnvironmentFile=-/etc/hyn-sysbackup.env
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
TimeoutStartSec=30min
